# ==============================================================================
# ORBICARE — Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT Secret for Session Cookie Authentication
JWT_SECRET="orbicare-secure-jwt-secret-key-elderly-care-2026"

# Google Gemini API Key for AI Meal Vision & Report OCR
